TOutlet
{
    patch           outlet2Flux;
    type            patchAverage;
    patches         (outlet2Flux);
    functionObjectLibs ("libfieldFunctionObjects.so");
    enabled         true;
    outputControl   timeStep;
    writeInterval   1;
    valueOutput     true;
    log             true;
    fields          (U);
    operation       patchIntegrate;
